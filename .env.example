# BusSense Database Configuration
# ==============================
# For MySQL backend:
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bussense
DB_USER=root
DB_PASSWORD=your_password

# Connection pooling settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# Fallback: if DB_DIALECT=sqlite, SQLite will be used at outputs/server_data/bussense_events.db
# DB_DIALECT=sqlite
